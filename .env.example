# Database Configuration (MySQL 8+)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smartedtech?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=smartedtech_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_BEFORE_RUNNING

# JWT Secret (minimum 32 bytes / 256 bits for HS256)
JWT_SECRET=replace_this_with_a_secure_random_string_of_at_least_32_characters_long

# CORS Allowed Origins (comma separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
APP_FILE_STORAGE_PATH=./uploads

# Initial Admin Bootstrap (created at startup if no admin exists)
APP_BOOTSTRAP_ADMIN_EMAIL=admin@smartedtech.com
APP_BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePassword123!

# Optional Integrations (Features return 503 if not configured)
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# JaaS (8x8 Jitsi as a Service)
JITSI_APP_ID=
JITSI_KID=
JITSI_PRIVATE_KEY_PATH=
